PORT=3000
BASE_URL=http://localhost:3000
# Razorpay credentials (keep secrets only in Render Environment settings)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
# Optional but recommended: configure a Razorpay webhook for payment.captured
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# PostgreSQL: use the Render Internal Database URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
DATABASE_SSL=true
# First admin account: created on first startup if this email is not already in the database
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace_with_a_long_unique_password
ADMIN_JWT_SECRET=replace_with_a_long_random_secret
STUDENT_JWT_SECRET=use_a_different_long_random_secret
# Optional fallback group invite. You can manage this securely from /admin.
WHATSAPP_GROUP_URL=
